config BR2_PACKAGE_KOBRA_NUMPY
	bool "kobra-numpy"
	depends on BR2_PACKAGE_PYTHON3
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_arm && BR2_ARM_EABIHF
	help
	  NumPy 1.23.5 (same source and options as Buildroot's python-numpy)
	  for the uClibc toolchain. Buildroot's python-numpy is limited to
	  glibc/musl because uClibc-ng ships no fenv.h for ARM; this package
	  adds a small header-only fenv.h for ARM hard-float (FPSCR). Needed
	  by Klipper's SHAPER_CALIBRATE / TEST_RESONANCES.
