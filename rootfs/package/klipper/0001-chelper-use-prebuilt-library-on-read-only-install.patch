chelper: use the prebuilt c_helper.so when the install is read-only

On the ShedNaja rootfs klippy lives in a read-only squashfs and
c_helper.so is cross-compiled at image build time (no gcc on the target).
Never try to rebuild it there, independent of file mtimes.

--- a/klippy/chelper/__init__.py
+++ b/klippy/chelper/__init__.py
@@ -284,6 +284,9 @@ def check_build_c_library():
     srcfiles = get_abs_files(srcdir, SOURCE_FILES)
     ofiles = get_abs_files(srcdir, OTHER_FILES)
     destlib = get_abs_files(srcdir, [DEST_LIB])[0]
+    if os.path.exists(destlib) and not os.access(srcdir, os.W_OK):
+        # Prebuilt library on a read-only install (ShedNaja)
+        return destlib
     if not check_build_code(srcfiles+ofiles+[__file__], destlib):
         # Code already built
         return destlib
