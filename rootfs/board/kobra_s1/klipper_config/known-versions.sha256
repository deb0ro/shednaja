2ff85ffd008ad308fbc138efa9e02147d8df66c0e41ba6a70893ed5ebbd5612a  kobra_macros.cfg
280bf1ed29a990bf0943f12732fdee317b4b503a74191984ca491ae5d18b1354  kobra_peripherals.cfg
