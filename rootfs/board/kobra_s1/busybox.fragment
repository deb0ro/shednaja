# on top of Buildroot's package/busybox/busybox.config
CONFIG_NTPD=y
CONFIG_FEATURE_NTPD_SERVER=y
CONFIG_FEATURE_NTPD_CONF=y
CONFIG_TIMEOUT=y
CONFIG_FEATURE_MDEV_DAEMON=y
CONFIG_FEATURE_MDEV_LOAD_FIRMWARE=y
CONFIG_MODPROBE=y
CONFIG_FEATURE_MODPROBE_BLACKLIST=y
CONFIG_DEPMOD=y
CONFIG_LSMOD=y
CONFIG_RMMOD=y
CONFIG_MODINFO=y
CONFIG_GUNZIP=y
CONFIG_ZCAT=y
CONFIG_XZCAT=y
CONFIG_RFKILL=y
CONFIG_MOUNTPOINT=y
CONFIG_REALPATH=y
CONFIG_FLOCK=y
CONFIG_DEVMEM=y
CONFIG_I2CDETECT=y
CONFIG_I2CGET=y
CONFIG_I2CSET=y
CONFIG_TRACEROUTE=y
