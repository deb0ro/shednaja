#!/bin/sh
#
# kobra-update - install a ShedNaja update bundle from the running system.
#
#   kobra-update [--yes] [--force] [--check] [--mode inplace-b] <bundle.tar>
#
# Bundle (tools/make_update_bundle.sh): uncompressed tar with "manifest" and up to three
# images (boot.img, oem.img, system.img), or for the Armbian variant rootfs.tar.gz (the
# Debian root, kernel and Klipper stack inside) with optional boot.img/system.img (base
# kernel, loader); manifest lines:
#   format=1
#   build_id=<id>
#   image <boot|oem|system|rootfs> <file> <size> <sha256>
#
# Armbian variant (kobra-ab present): the rootfs goes into the inactive root directory on
# useremain with kobra-ab install (A/B: the loader tries it, rolls back if it does not
# confirm itself), boot/system are written in place with readback (rarely in a bundle);
# no PID 1 handover is needed because nothing is overwritten that the running system uses.
#
# Mode "inplace" (the only one so far; "inplace-b" is the old name): we run from one slot
# (A or B, see /usr/libexec/kobra/current-slot), the other keeps the stock firmware as the
# fallback. The images are rewritten into boot/oem/system of our slot in place,
# like OpenWrt's sysupgrade: after verifying the bundle, kobra-update leaves the plan in
# /dev/.kobra-update-pending and sends SIGQUIT to init. busybox init stops all services
# (rcK), kills every process, unmounts, and execs /usr/libexec/kobra/update-stage2 as
# PID 1 (inittab ::restart:), which moves PID 1 into a busybox chroot in RAM and runs
# update-writer there: nothing reads the squashfs root while our system partition is
# overwritten.
# Every partition is read back and compared, then the board reboots. If a write cannot be
# verified, the A/B metadata is switched to the other slot (stock) first. A power loss during the
# write leaves an unbootable B (power-cycle until SPL's retry counter falls back to A).
# A full A/B mode with our system in both slots is planned as a second variant.
#
# --check  verify the bundle and print what would be written, write nothing
# --yes    no confirmation prompt (USB update, scripts)
# --remove-bundle  delete the bundle file once it is unpacked and verified (uploads from
#          Mainsail into printer_data/config/updates, see SHEDNAJA_UPDATE in kobra_slot)
# --force  install even while a print is running / paused, or when the print state
#          cannot be read while Klipper runs
# --to-lite / --to-armbian  switch the variant: a bundle for the other variant (manifest
#          variant=lite|armbian, no line = lite) is refused without the matching flag. Lite to
#          Armbian needs a complete bundle (rootfs + boot + system): the root goes to
#          /useremain/armbian/root_a (with this board's host keys and root password) before the
#          usual handover writes boot/system. Armbian to Lite writes Lite's boot/system into our
#          slot; Armbian's roots and data stay on useremain (docs/update.md, way back).
# One update at a time: a lock on /useremain/shednaja/update/.lock, and nothing new starts
# while an update is pending (handed over, waiting for the shutdown).
# The bundle may only hold manifest and <part>.img, as plain files.
# Manifest lines are checked strictly (fixed image names <part>.img, numeric size,
# 64-digit sha256), so nothing from the bundle ends up in the plan for stage 2 unchecked.
set -eu

MODE=inplace; YES=0; FORCE=0; CHECK=0; REMOVE=0; TO=""; BUNDLE=""
while [ $# -gt 0 ]; do
	case "$1" in
		--yes) YES=1 ;;
		--force) FORCE=1 ;;
		--check) CHECK=1 ;;
		--remove-bundle) REMOVE=1 ;;
		--to-lite) TO=lite ;;
		--to-armbian) TO=armbian ;;
		--mode) MODE="$2"; shift ;;
		--mode=*) MODE="${1#--mode=}" ;;
		-h|--help) sed -n '2,50p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		-*) echo "unknown option $1" >&2; exit 2 ;;
		*) BUNDLE="$1" ;;
	esac
	shift
done
[ -n "$BUNDLE" ] && [ -f "$BUNDLE" ] || { echo "usage: kobra-update [--yes] [--force] [--check] [--remove-bundle] [--to-lite|--to-armbian] <bundle.tar>" >&2; exit 2; }
case "$MODE" in inplace|inplace-b) ;; *) echo "mode $MODE is not implemented (only inplace)" >&2; exit 2 ;; esac

UPD=/useremain/shednaja/update
STAGE=$UPD/stage
LOG=$UPD/last-update.log
log() { echo "kobra-update: $*"; echo "$(date '+%F %T') $*" >> "$LOG"; echo "kobra-update: $*" > /dev/kmsg 2>/dev/null || true; }
die() { log "ERROR: $*"; exit 1; }
# The staged images (tens of MB on /useremain) go when this run ends without handing them
# over; only the ones this run unpacked, never those of a running or handed-over update.
OWN_STAGE=0
trap '[ "$OWN_STAGE" = 1 ] && rm -rf "$STAGE"' EXIT
trap 'exit 130' INT TERM HUP

mountpoint -q /useremain || die "/useremain not mounted"
mkdir -p "$UPD"
exec 9> "$UPD/.lock"
flock -n 9 || die "another kobra-update is running"
[ -e /dev/.kobra-update-pending ] && die "an update is already handed over and waits for the reboot"
S=$(/usr/libexec/kobra/current-slot)
[ -n "$S" ] || die "cannot tell the running slot from /proc/cmdline"
# Armbian variant: the Debian root lives in /useremain/armbian/root_a|b (kobra-ab)
AB=0; [ -x /usr/local/sbin/kobra-ab ] && AB=1

# ---- unpack and verify ------------------------------------------------------------
log "bundle $BUNDLE ($(wc -c < "$BUNDLE") B)"
OWN_STAGE=1; rm -rf "$STAGE"; mkdir -p "$STAGE"
# Only the expected members, each once and as a plain file: no paths, links or devices
# from the bundle end up in /useremain.
set -f	# member names are not globs
NAMES=$(tar -tf "$BUNDLE") || die "cannot read bundle"
for n in $NAMES; do
	case "$n" in manifest|boot.img|oem.img|system.img|rootfs.tar.gz) ;; *) die "unexpected file in bundle: $n" ;; esac
done
[ -z "$(echo "$NAMES" | sort | uniq -d)" ] || die "a file is in the bundle twice"
tar -xf "$BUNDLE" -C "$STAGE" $NAMES || die "cannot unpack bundle"
for n in $NAMES; do
	set -- $(ls -ldn "$STAGE/$n")
	case "$1" in -*) ;; *) die "$n in the bundle is not a regular file" ;; esac
	[ "$2" = 1 ] || die "$n in the bundle is a hard link"
done
set +f
M=$STAGE/manifest
[ -f "$M" ] || die "bundle has no manifest"
grep -qx 'format=1' "$M" || die "unsupported bundle format"
BID=$(sed -n 's/^build_id=//p' "$M")
# the build id goes into logs, installed.manifest and (Armbian) the new root's os-release
case "$BID" in ''|*[!A-Za-z0-9._+-]*) die "bad build_id in manifest" ;; esac
# which variant the bundle is for, and whether that switches ours (only with --to-<variant>)
case "$(sed -n 's/^variant=//p' "$M")" in armbian) VARIANT=armbian ;; *) VARIANT=lite ;; esac
OURS=lite; [ "$AB" = 1 ] && OURS=armbian
if [ "$VARIANT" != "$OURS" ] && [ "$TO" != "$VARIANT" ]; then
	die "this bundle is for the $VARIANT variant, this printer runs $OURS: switching needs --to-$VARIANT"
fi
[ -z "$TO" ] || [ "$TO" = "$VARIANT" ] || die "--to-$TO given, but the bundle is for $VARIANT"
PLAN=""
SEEN=""
while read -r kw part file size sum extra; do
	[ "$kw" = image ] || continue
	case "$part" in boot|oem|system|rootfs) ;; *) die "unknown partition in manifest" ;; esac
	case " $SEEN " in *" $part "*) die "partition $part twice in manifest" ;; esac
	SEEN="$SEEN $part"
	if [ "$part" = rootfs ]; then
		[ "$VARIANT" = armbian ] || die "rootfs in a bundle that is not variant=armbian"
		[ "$file" = rootfs.tar.gz ] || die "rootfs: image must be named rootfs.tar.gz"
	else
		[ "$file" = "$part.img" ] || die "$part: image must be named $part.img"
	fi
	[ "$AB" = 1 ] && [ "$part" = oem ] && die "the Armbian variant does not use the oem partition"
	case "$size" in ''|*[!0-9]*) die "$part: bad size in manifest" ;; esac
	[ ${#sum} = 64 ] || die "$part: bad sha256 in manifest"
	case "$sum" in *[!0-9a-f]*) die "$part: bad sha256 in manifest" ;; esac
	[ -z "$extra" ] || die "$part: extra fields in manifest"
	f=$STAGE/$file
	[ -f "$f" ] || die "missing $file"
	[ "$(wc -c < "$f")" = "$size" ] || die "$file: size differs from manifest"
	[ "$(sha256sum "$f" | cut -d' ' -f1)" = "$sum" ] || die "$file: sha256 mismatch"
	if [ "$part" = rootfs ]; then
		# unpacked about 3.5 times the archive, next to the staged archive and two roots
		avail=$(( $(df -k /useremain | awk 'NR==2 {print $4}') * 1024 ))
		[ "$avail" -ge $((size * 4)) ] || die "rootfs: not enough space on useremain ($avail B free, $((size * 4)) B needed)"
		if [ "$AB" = 1 ]; then log "  inactive Armbian root <- $file ($size B, sha256 ${sum%"${sum#????????????}"}...)"
		else log "  /useremain/armbian/root_a <- $file ($size B, sha256 ${sum%"${sum#????????????}"}...)"; fi
		PLAN="$PLAN $part:$file:$size:$sum"
		continue
	fi
	dev=$(readlink -f /dev/block/by-name/${part}_$S)
	psize=$(( $(cat /sys/class/block/$(basename "$dev")/size) * 512 ))
	[ "$size" -le "$psize" ] || die "$file ($size B) does not fit ${part}_$S ($psize B)"
	if [ "$(head -c "$size" "$dev" | sha256sum | cut -d' ' -f1)" = "$sum" ]; then
		log "  ${part}_$S: already identical, skipped"
	else
		log "  ${part}_$S <- $file ($size B, sha256 ${sum%"${sum#????????????}"}...)"
		PLAN="$PLAN $part:$file:$size:$sum"
	fi
done < "$M"
log "bundle build_id=$BID ($VARIANT), running BUILD_ID=$(sed -n 's/^BUILD_ID=//p' /etc/os-release) ($OURS)"
if [ "$AB" = 0 ] && [ "$VARIANT" = armbian ]; then
	for part in rootfs boot system; do
		case " $SEEN " in *" $part "*) ;; *) die "switching to Armbian needs a complete bundle: no $part" ;; esac
	done
fi
if [ -z "$PLAN" ]; then
	log "nothing to write: every partition already matches the bundle"
	cp "$M" "$UPD/installed.manifest"
	rm -rf "$STAGE"; exit 0
fi
if [ "$CHECK" = 1 ]; then
	log "check only - nothing written"
	rm -rf "$STAGE"; exit 0
fi

# ---- printer must be idle ---------------------------------------------------------
# Klipper not running (USB update at boot, before S60): nothing can print. Klipper running:
# the state has to be readable and not printing/paused, unless --force.
print_state() {	# the print state; "idle" without klippy, "" when Moonraker does not say
	# busybox: pidof/ps; Debian (Armbian): klippy runs as python3, procps ps shows only the tty
	pidof klippy.py > /dev/null 2>&1 || ps | grep -q '[k]lippy.py' ||
		{ command -v pgrep > /dev/null && pgrep -f klippy.py > /dev/null; } || { echo idle; return 0; }
	wget -q -T 5 -O - "http://127.0.0.1:7125/printer/objects/query?print_stats=state" 2>/dev/null |
		sed -n 's/.*"state": *"\([a-z]*\)".*/\1/p'
}
check_idle() {
	state=$(print_state)
	case "$state" in
		idle|standby|complete|cancelled|error) return 0 ;;
		printing|paused) msg="printer is $state - finish or cancel the print first" ;;
		*) msg="cannot read the print state from Moonraker" ;;
	esac
	[ "$FORCE" = 1 ] && { log "WARNING: $msg - continuing (--force)"; return 0; }
	die "$msg (or --force)"
}
check_idle

if [ "$YES" != 1 ]; then
	printf 'Write the partitions above and reboot? Klipper stops now. [y/N] '
	read -r a; case "$a" in y|Y|yes) ;; *) log "aborted by user"; exit 1 ;; esac
	check_idle	# a print may have started while the question was open
fi
# only now: a refusal above (a print started, no confirmation) keeps the uploaded bundle
[ "$REMOVE" = 1 ] && rm -f "$BUNDLE" && log "bundle file removed (its images are staged and verified)"

# ---- Armbian variant: install while running, then reboot ---------------------------
# The root goes into the inactive directory (the running one is not touched); boot/system
# hold only the base kernel and the loader squashfs, which nothing reads after the loader's
# pivot_root (its old root is detached first).
if [ "$AB" = 1 ]; then
	for item in $PLAN; do
		part=${item%%:*}; rest=${item#*:}; file=${rest%%:*}; rest=${rest#*:}; size=${rest%%:*}; sum=${rest#*:}
		if [ "$part" = rootfs ]; then
			log "installing the root into the inactive slot (kobra-ab install)"
			/usr/local/sbin/kobra-ab install "$STAGE/$file" --no-reboot || die "kobra-ab install failed"
			# the bundle's build id in the new root, as Lite's os-release carries it
			t=$(sed -n 's/^TRY=\([ab]\)$/\1/p' /useremain/armbian/ab/state)
			[ -n "$t" ] && echo "BUILD_ID=$BID" >> "/useremain/armbian/root_$t/etc/os-release"
			continue
		fi
		dev=$(readlink -f /dev/block/by-name/${part}_$S)
		[ "$part" = system ] && [ "$(findmnt -n -o FSTYPE /mnt 2>/dev/null)" = squashfs ] && umount -l /mnt
		ok=0
		for try in 1 2; do
			dd if="$STAGE/$file" of="$dev" bs=64k conv=fsync 2>/dev/null
			sync; echo 3 > /proc/sys/vm/drop_caches
			[ "$(head -c "$size" "$dev" | sha256sum | cut -d' ' -f1)" = "$sum" ] && { ok=1; break; }
			log "  ${part}_$S: readback differs (try $try)"
		done
		[ "$ok" = 1 ] || die "${part}_$S could not be written; SPL falls back to the other slot after its tries"
		log "  ${part}_$S written and verified"
	done
	cp "$M" "$UPD/installed.manifest"
	rm -rf "$STAGE"; OWN_STAGE=0
	# Klipper kept running while the root was installed: no reboot into a print started meanwhile
	# (also with --force: that only allowed the install, a reboot would end the print)
	case "$(print_state)" in
		idle|standby|complete|cancelled|error) ;;
		*) log "update $BID installed; the printer is busy (or its state unknown), so the new system starts at the next restart"
		   exit 0 ;;
	esac
	log "update $BID installed, rebooting (the new root is tried, then confirmed or rolled back)"
	sync; systemctl reboot
	exit 0
fi

# ---- Lite to Armbian: the root waits for the Armbian loader, the handover writes boot/system
# The Armbian loader unpacks /useremain/armbian/install/rootfs.tar.gz on its first boot (with
# numeric owners) and applies this board's identity: dropbear host keys, root password.
if [ "$AB" = 0 ] && [ "$VARIANT" = armbian ]; then
	I=/useremain/armbian/install
	rm -rf "$I"; mkdir -p "$I/dropbear"
	mv "$STAGE/rootfs.tar.gz" "$I/" || die "cannot move the Armbian root to $I"
	for f in /etc/dropbear/dropbear_*_host_key; do [ -f "$f" ] && cp "$f" "$I/dropbear/"; done
	sed -n 's/^root:\([^:]*\):.*/\1/p' /etc/shadow > "$I/root.hash"
	echo "$BID" > "$I/BUILD_ID"; sync
	PLAN=$(for item in $PLAN; do case "$item" in rootfs:*) ;; *) printf '%s ' "$item" ;; esac; done)
	log "Armbian root staged in $I (unpacked on the first Armbian boot); writing boot/system next"
fi

# ---- hand over to init: shutdown, then PID 1 in RAM writes our slot ----------------
grep -q '^::restart:/usr/libexec/kobra/update-stage2' /etc/inittab || die "this rootfs has no update stage 2"
OWN_STAGE=0	# from here on the staged images belong to stage 2
{
	echo "PLAN=$PLAN"
	echo "SLOT=$S"
	echo "UDEV=$(readlink -f /dev/block/by-name/useremain)"
	for part in boot oem system; do echo "DEV_$part=$(readlink -f /dev/block/by-name/${part}_$S)"; done
} > /dev/.kobra-update-pending
log "planned:$PLAN"
log "handing over to init: all services stop now, the printer reboots when the update is written (about 1 min)"
# milestones of the handover (rcS end, rcK, stage 2, writer) with uptime, see docs/update.md
echo "$(cut -d' ' -f1 /proc/uptime) kobra-update: handover (SIGQUIT to init)" > "$UPD/trace.log"
sync
kill -QUIT 1
