#!/bin/sh
#
# Moonraker from /usr/lib/moonraker, data path /useremain/shednaja/printer_data
# (config/moonraker.conf, logs/moonraker.log, database/, gcodes/).

PD=/useremain/shednaja/printer_data
PIDFILE=/run/moonraker.pid
# Moonraker buffers every upload in the temp directory before moving it into place; /tmp is a
# small tmpfs in RAM (117 MB on the Armbian variant), too small for an update bundle or a big
# G-code file, so its temp files go to useremain (emptied at each start).
TMP=/useremain/shednaja/tmp

start() {
	/usr/libexec/kobra/printer-data-init || return 1
	mkdir -p $TMP && rm -rf $TMP/* $TMP/.[!.]* 2>/dev/null
	TMPDIR=$TMP HOME=/root PYTHONPATH=/usr/lib/moonraker \
	start-stop-daemon -S -q -b -m -p $PIDFILE -N 5 -x /usr/bin/python3 -- \
		-m moonraker -d $PD
}

stop() {
	start-stop-daemon -K -q -p $PIDFILE
	rm -f $PIDFILE
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
