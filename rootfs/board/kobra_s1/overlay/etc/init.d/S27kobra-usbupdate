#!/bin/sh
#
# Update from a USB stick at boot: if the stick (FAT/exFAT, first partition or whole
# disk) has shednaja-update*.tar in its root folder, install it with kobra-update.
# Runs after S25kobra-usb (hub power) and before Klipper/Moonraker start. A bundle whose
# manifest equals the last installed one is skipped, so leaving the stick in is harmless.
# The Armbian variant runs this too (kobra-usbupdate.service, before Klipper) and looks
# for shednaja-armbian-update*.tar instead, so a stick for one variant never switches the other.
# Each bundle is tried only once: if the update fails, the next boot does not try it
# again (no reboot loop); a different bundle, or removing $TRIED, allows a new try.
# With several bundles the newest file wins (its time on the stick; the names carry a commit
# hash, so their order says nothing).

MNT=/tmp/kobra-usbupdate
UPD=/useremain/shednaja/update
LAST=$UPD/installed.manifest
TRIED=$UPD/usb-tried.manifest
PATTERN=shednaja-update
[ -x /usr/local/sbin/kobra-ab ] && PATTERN=shednaja-armbian-update

wait_for() {	# wait_for <seconds> <glob>
	n=0
	while [ $n -lt $(($1 * 4)) ]; do
		ls $2 >/dev/null 2>&1 && return 0
		if command -v usleep > /dev/null; then usleep 250000; else sleep 0.25; fi
		n=$((n + 1))
	done
	return 1
}

case "$1" in
	start)
		# no mass storage device on the hub after 5 s: nothing to do
		wait_for 5 "/sys/bus/usb/drivers/usb-storage/*:*" || exit 0
		wait_for 10 "/sys/block/sd*" || exit 0
		if command -v mdev > /dev/null; then mdev -s; else udevadm settle -t 10; fi
		mkdir -p $MNT
		for dev in /dev/sd[a-z]1 /dev/sd[a-z]; do
			[ -b "$dev" ] || continue
			mount -o ro "$dev" $MNT 2>/dev/null || continue
			b=$(ls -t $MNT/$PATTERN*.tar 2>/dev/null | head -n 1)
			if [ -n "$b" ]; then
				if tar -xOf "$b" manifest 2>/dev/null | cmp -s - "$LAST"; then
					echo "kobra-usbupdate: $(basename "$b") already installed" > /dev/kmsg
				elif tar -xOf "$b" manifest 2>/dev/null | cmp -s - "$TRIED"; then
					echo "kobra-usbupdate: $(basename "$b") failed before, not trying again" > /dev/kmsg
				else
					echo "kobra-usbupdate: installing $(basename "$b") from $dev" > /dev/kmsg
					mkdir -p $UPD
					tar -xOf "$b" manifest > $TRIED; sync
					# hands over to init: the write runs once rcS is done, then the board reboots
					kobra-update --yes "$b"
				fi
			fi
			umount $MNT
			[ -n "$b" ] && break
		done
		;;
	stop)
		[ -f /dev/.kobra-update-pending ] &&
			echo "$(cut -d' ' -f1 /proc/uptime) rcK: S27 stop" >> $UPD/trace.log
		;;
	*)
		echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
exit 0
