#!/bin/sh
#
# Klipper host (klippy) from /usr/lib/klipper, config/logs in printer_data on /useremain.
# Before starting, both MCUs are reset with GPIO116 (sequence from the Kobra-S1 klipper
# fork README: export, direction out, 1 s, value 1), so klippy finds them in a clean state.

PD=/useremain/shednaja/printer_data
PIDFILE=/run/klippy.pid
GPIO=116

mcu_reset() {
	[ -d /sys/class/gpio/gpio$GPIO ] || echo $GPIO > /sys/class/gpio/export
	echo out > /sys/class/gpio/gpio$GPIO/direction
	sleep 1
	echo 1 > /sys/class/gpio/gpio$GPIO/value
	sleep 2		# bootloader -> application
	echo "klipper: MCU reset pulse on GPIO$GPIO" > /dev/kmsg
}

start() {
	/usr/libexec/kobra/printer-data-init || return 1
	mcu_reset
	# nice -10: klippy must get the single CPU in time even when the display decodes the
	# camera stream and Moonraker is busy; at 100 % CPU the main MCU shut down with
	# "Timer too close" during homing
	HOME=/root start-stop-daemon -S -q -b -m -p $PIDFILE -N -10 -x /usr/bin/python3 -- \
		/usr/lib/klipper/klippy/klippy.py $PD/config/printer.cfg \
		-I /tmp/printer -l $PD/logs/klippy.log -a /tmp/klippy_uds
}

stop() {
	start-stop-daemon -K -q -p $PIDFILE
	rm -f $PIDFILE
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
