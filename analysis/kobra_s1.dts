    };
    csi2-dphy0 {
        compatible = "rockchip,rv1106-csi2-dphy";
        rockchip,hw = <0xA>;
        status = "okay";
        ports {
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            port@0 {
                reg = <0x0>;
