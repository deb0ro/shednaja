    rockchip-amp {
        compatible = "rockchip,amp";
        clocks = <0x2 0x3B 0x2 0x53 0x2 0x59 0x2 0x5F 0x2 0x42 0x2 0x123>;
        status = "okay";
    };
    chosen {
        bootargs = "earlycon=,mmio32,0xff4c0000 console= rootwait snd_soc_core.prealloc_buffer_size_kbytes=16 coherent_pool=0 root=/dev/mmcblk0p8 rootfstype=squashfs rk_dma_heap_cma=18M";
    };
    vcc-1v8 {
        compatible = "regulator-fixed";
        regulator-name = "vcc_1v8";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <0x1B7740>;
        regulator-max-microvolt = <0x1B7740>;
        phandle = <0x2B>;
    };
    vcc-3v3 {
        compatible = "regulator-fixed";
        regulator-name = "vcc_3v3";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <0x325AA0>;
        regulator-max-microvolt = <0x325AA0>;
    };
    vdd-arm {
        compatible = "pwm-regulator";
        pwms = <0x68 0x0 0x1388 0x1>;
        regulator-name = "vdd_arm";
        regulator-min-microvolt = <0xB0C20>;
        regulator-max-microvolt = <0x1072F0>;
        regulator-init-microvolt = <0xE7EF0>;
        regulator-always-on;
        regulator-boot-on;
        regulator-settling-time-up-us = <0xFA>;
        phandle = <0x4>;
    };
    vcc3v3-wifi {
        compatible = "regulator-fixed";
        regulator-name = "vcc3v3_wifi";
        regulator-boot-on;
        regulator-always-on;
        regulator-min-microvolt = <0x325AA0>;
        regulator-max-microvolt = <0x325AA0>;
        enable-active-high;
        pinctrl-names = "default";
        pinctrl-0 = <0x6A>;
        gpio = <0x2E 0x3 0x0>;
    };
    backlight {
        status = "okay";
        compatible = "pwm-backlight";
        pwms = <0x6D 0x0 0x61A8 0x0>;
        brightness-levels = <0x0 0x1 0x2 0x3 0x4 0x5 0x6 0x7 0x8 0x9 0xA 0xB 0xC 0xD 0xE 0xF 0x10 0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1A 0x1B 0x1C 0x1D 0x1E 0x1F 0x20 0x21 0x22 0x23 0x24 0x25 0x26 0x27 0x28 0x29 0x2A 0x2B 0x2C 0x2D 0x2E 0x2F 0x30 0x31 0x32 0x33 0x34 0x35 0x36 0x37 0x38 0x39 0x3A 0x3B 0x3C 0x3D 0x3E 0x3F 0x40 0x41 0x42 0x43 0x44 0x45 0x46 0x47 0x48 0x49 0x4A 0x4B 0x4C 0x4D 0x4E 0x4F 0x50 0x51 0x52 0x53 0x54 0x55 0x56 0x57 0x58 0x59 0x5A 0x5B 0x5C 0x5D 0x5E 0x5F 0x60 0x61 0x62 0x63 0x64 0x65 0x66 0x67 0x68 0x69 0x6A 0x6B 0x6C 0x6D 0x6E 0x6F 0x70 0x71 0x72 0x73 0x74 0x75 0x76 0x77 0x78 0x79 0x7A 0x7B 0x7C 0x7D 0x7E 0x7F 0x80 0x81 0x82 0x83 0x84 0x85 0x86 0x87 0x88 0x89 0x8A 0x8B 0x8C 0x8D 0x8E 0x8F 0x90 0x91 0x92 0x93 0x94 0x95 0x96 0x97 0x98 0x99 0x9A 0x9B 0x9C 0x9D 0x9E 0x9F 0xA0 0xA1 0xA2 0xA3 0xA4 0xA5 0xA6 0xA7 0xA8 0xA9 0xAA 0xAB 0xAC 0xAD 0xAE 0xAF 0xB0 0xB1 0xB2 0xB3 0xB4 0xB5 0xB6 0xB7 0xB8 0xB9 0xBA 0xBB 0xBC 0xBD 0xBE 0xBF 0xC0 0xC1 0xC2 0xC3 0xC4 0xC5 0xC6 0xC7 0xC8 0xC9 0xCA 0xCB 0xCC 0xCD 0xCE 0xCF 0xD0 0xD1 0xD2 0xD3 0xD4 0xD5 0xD6 0xD7 0xD8 0xD9 0xDA 0xDB 0xDC 0xDD 0xDE 0xDF 0xE0 0xE1 0xE2 0xE3 0xE4 0xE5 0xE6 0xE7 0xE8 0xE9 0xEA 0xEB 0xEC 0xED 0xEE 0xEF 0xF0 0xF1 0xF2 0xF3 0xF4 0xF5 0xF6 0xF7 0xF8 0xF9 0xFA 0xFB 0xFC 0xFD 0xFE 0xFF>;
        default-brightness-level = <0xC8>;
        enable-gpios = <0x2E 0x0 0x0>;
        phandle = <0x6E>;
    };
    panel {
        compatible = "simple-panel";
        bus-format = <0x1009>;
        backlight = <0x6E>;
        enable-gpios;
        enable-delay-ms = <0x14>;
        reset-gpios;
        reset-value = <0x0>;
        reset-delay-ms = <0xA>;
        status = "okay";
        display-timings {
            native-mode = <0x6F>;
            timing0 {
                clock-frequency = <0x1DCD650>;
                hactive = <0x320>;
                hback-porch = <0x8>;
                hfront-porch = <0x8>;
                hsync-len = <0x4>;
                vactive = <0x1E0>;
                vback-porch = <0x8>;
                vfront-porch = <0x8>;
                vsync-len = <0x4>;
                hsync-active = <0x0>;
                vsync-active = <0x0>;
                de-active = <0x0>;
                pixelclk-active = <0x0>;
                phandle = <0x6F>;
            };
        };
        port {
            endpoint {
                remote-endpoint = <0x70>;
                phandle = <0x1F>;
            };
        };
    };
    wireless-wlan {
        compatible = "wlan-platdata";
        wifi_chip_type = "rtl8723ds";
        pinctrl-names = "default";
        status = "okay";
    };
    wireless_bluetooth {
        compatible = "bluetooth-platdata";
        uart_rts_gpios = <0x2E 0x5 0x1>;
        pinctrl-names = "default", "rts_gpio";
        pinctrl-0 = <0x71>;
        pinctrl-1 = <0x72>;
        BT,reset_gpio = <0x2E 0x4 0x0>;
        status = "okay";
    };
    reserved-memory {
        #address-cells = <0x1>;
        #size-cells = <0x1>;
        ranges;
        linux,cma {
            compatible = "shared-dma-pool";
            inactive;
            reusable;
            size = <0x1000000>;
            linux,cma-default;
        };
        drm-logo@00000000 {
            compatible = "rockchip,drm-logo";
            reg = <0x0 0x0>;
            phandle = <0x11>;
        };
    };
};
