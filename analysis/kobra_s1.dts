                };
                endpoint@1 {
                    reg = <0x1>;
                    remote-endpoint = <0xC>;
                    data-lanes = <0x1 0x2>;
                    phandle = <0x34>;
                };
                endpoint@2 {
                    reg = <0x2>;
                    remote-endpoint = <0xD>;
                    data-lanes = <0x1 0x2>;
                    phandle = <0x35>;
                };
                endpoint@3 {
                    reg = <0x3>;
                    remote-endpoint = <0xE>;
                    data-lanes = <0x1 0x2>;
                    phandle = <0x36>;
                };
            };
            port@1 {
                reg = <0x1>;
                #address-cells = <0x1>;
                #size-cells = <0x0>;
                endpoint@0 {
                    reg = <0x0>;
                    remote-endpoint = <0xF>;
                    phandle = <0x4F>;
                };
            };
