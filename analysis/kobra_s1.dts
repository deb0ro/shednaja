        serial1 = "/serial@ff4b0000";
        serial2 = "/serial@ff4c0000";
        serial3 = "/serial@ff4d0000";
        serial4 = "/serial@ff4e0000";
        serial5 = "/serial@ff4f0000";
        spi0 = "/spi@ff500000";
        spi1 = "/spi@ff510000";
        spi2 = "/spi@ffac0000";
