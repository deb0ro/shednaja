/dts-v1/;
// version: 17
// last_comp_version: 16
// boot_cpuid_phys: 0x0

/memreserve/ 0x7fa0d4736000 0x600;
/ {
    #address-cells = <0x1>;
    #size-cells = <0x1>;
    compatible = "rockchip,rv1106g-38x38-ipc-v10-spi-nand", "rockchip,rv1106";
    interrupt-parent = <0x1>;
    model = "Rockchip RV1106G IPC38 V10 SPI NAND Board";
    aliases {
        csi2dphy0 = "/csi2-dphy0";
        csi2dphy1 = "/csi2-dphy1";
        csi2dphy2 = "/csi2-dphy2";
