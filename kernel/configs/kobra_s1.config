# Kobra S1 host kernel - config fragment on top of the RV1106 SDK defaults:
#   rv1106_defconfig + rv1106-evb.config + kobra_s1.config
# The base matches the stock kernel closely (same module set in /oem/usr/ko).
# The options below come from comparing the stock kallsyms with our System.map
# (analysis/kernel/compare_syms.py, see docs/kernel-build.md).

# ---- additions over stock ----
# kernel log on UART2 from the first line (earlycon=uart8250 in bootargs);
# the FIQ debugger stays the main console (console=ttyFIQ0)
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
# /proc/config.gz - stock has no embedded config, ours should
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# ---- present in stock, missing in the SDK defaults ----
# timers (stock: hrtimer_interrupt, tick-oneshot)
CONFIG_HIGH_RES_TIMERS=y

# Bluetooth core built in (RTL8723DS BT on UART1). Stock loads Realtek's vendor
# hci_uart.ko (v2.2, with rtk_btcoex, out of tree) - not the mainline one, so
# BT_HCIUART stays off here (see docs/kernel-build.md, missing pieces).
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_LE=y
CONFIG_BT_DEBUGFS=y
CONFIG_RFKILL=y
CONFIG_RFKILL_RK=y
CONFIG_RFKILL_GPIO=y

# crypto used by BT SMP / Wi-Fi / userspace (stock: ecc, ecdh, ccm, cmac, af_alg, drbg)
CONFIG_CRYPTO_USER=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DRBG_MENU=y
CONFIG_CRYPTO_DRBG_HMAC=y
CONFIG_CRYPTO_JITTERENTROPY=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_CRYPTO_USER_API_AEAD=y

# USB host: storage (print files from a stick), serial/ACM (MCUs, CH340/CP210x),
# network adapters, HID, usbmon - all built in in stock
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_SPI_ATTRS=y
CONFIG_USB_STORAGE=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_MON=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y
CONFIG_HIDRAW=y

# printer camera = UVC on the GL850G hub
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_USB_GSPCA=m

# file systems for USB sticks
CONFIG_EXFAT_FS=y
# GPT-formatted sticks (common now; the stock kernel reads only MBR). The eMMC keeps its
# blkdevparts= layout: the cmdline parser runs before the GPT one.
CONFIG_PARTITION_ADVANCED=y
CONFIG_CMDLINE_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_NLS_UTF8=y
CONFIG_NLS_CODEPAGE_936=y

# input
CONFIG_SERIO=y
CONFIG_SERIO_SERPORT=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_MOUSEDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
# FocalTech touch ("focaltech,fts" on I2C3). The Hynitron CST7xx, TLSC6x and
# XPT7603 drivers of the stock kernel are Anycubic additions, not in the SDK.
CONFIG_TOUCHSCREEN_FTS=y
