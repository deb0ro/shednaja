[Unit]
Description=HelixScreen (ShedNaja S70helixscreen)
After=moonraker.service
# the data copy must be mounted: without it /useremain/shednaja is Lite's own data
RequiresMountsFor=/useremain/shednaja

[Service]
Type=forking
PIDFile=/run/helixscreen.pid
ExecStart=/usr/libexec/kobra/init/S70helixscreen start
ExecStop=/usr/libexec/kobra/init/S70helixscreen stop
OOMScoreAdjust=200

[Install]
WantedBy=multi-user.target
